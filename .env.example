# cb-agent 环境变量示例
# 复制为 .env 并填入实际值。.env 已在 .gitignore 中，不会被提交。

# ========== LLM ==========
# 主对话模型，必填。可用任意 OpenAI 兼容 API：DeepSeek / 阿里百炼 / 火山方舟 / 魔搭 / OpenAI / Ollama 等
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_ID=deepseek-chat
LLM_TIMEOUT=60

# ========== Logging ==========
# basic: key lifecycle/warnings/errors; detail: round/tool/gateway debug + summary messages; full: debug + full LLM messages
CBAGENT_LOG_LEVEL=basic
# Optional. Relative paths are resolved from the project root.
CBAGENT_LOG_DIR=.cbagent/logs
# 控制台 LLM 入参/出参追踪，专门用于排查“模型到底看到了什么上下文”。
# - summary: 默认值；每次 think 前后在 stderr 打印 role、字符数、短内容预览、工具列表和 tool_calls。
# - full: 打印更完整的文本内容；图片 data URI/base64 仍会被折叠，避免终端被大附件刷爆。
# - off: 关闭控制台追踪。TUI/JSON-RPC 的协议走 stdout，所以这里始终输出到 stderr，不会破坏前端协议。
CBAGENT_LLM_CONSOLE_IO=summary

# ========== Feature Flags ==========
# 危险权限模式。1/true/on 启用后等价于启动参数 --dangerously-skip-permissions。
# 开启后 BashTool 会跳过权限确认和高危命令拦截，agent 可以直接执行任意 bash 命令。
# 仅在完全信任当前模型、提示词、工作目录和运行环境时使用；生产/公网/群聊场景不建议开启。
CBAGENT_DANGEROUSLY_SKIP_PERMISSIONS=0

# Buddy 虚拟宠物。1/true/on 启用；未启用时 /buddy 只显示开启提示。
FEATURE_BUDDY=0

# ========== Attachments / Multimodal Input ==========
# 单个图片/音频附件大小上限，单位 MB。附件二进制不写入 history/compact。
CBAGENT_ATTACHMENT_MAX_MB=20

# ========== QQ / NapCat / OneBot ==========
# QQ/NapCat 接入使用 OneBot V11 反向 WebSocket:
#   1. cb-agent 先启动 WebSocket 服务: python run_agent.py --transport qq
#   2. NapCat 再作为客户端连接: ws://<QQ_HOST>:<QQ_PORT>/onebot/v11/ws
#   3. QQ_ENABLE=0 时即使命令使用 --transport qq，也不会真正监听 QQ 服务。
QQ_ENABLE=0

# cb-agent WebSocket 服务监听地址。
# - 本机 NapCat 推荐 127.0.0.1，只允许本机连接，更安全。
# - Docker、虚拟机或局域网其它机器连接时可改成 0.0.0.0，并务必配置 QQ_ACCESS_TOKEN。
QQ_HOST=127.0.0.1

# cb-agent WebSocket 服务监听端口。NapCat 反向 WebSocket URL 中的端口必须与这里一致。
QQ_PORT=6199

# 可选访问令牌。为空表示不校验；填写后 NapCat 侧也要配置同一个 token。
# 适配器会接受 Authorization: Bearer <token>、Authorization: <token> 或 URL access_token=<token>。
QQ_ACCESS_TOKEN=

# 群聊触发策略。
# - mention: 默认值；群聊中 @机器人 或使用 QQ_WAKE_PREFIX 前缀才响应。
# - prefix: 只响应 QQ_WAKE_PREFIX 前缀，不响应单纯 @。
# - all: 群里所有消息都进入 agent，容易刷屏，建议只在测试群或配合白名单使用。
# 私聊不受该配置影响，默认直接响应。
QQ_GROUP_MODE=mention

# 群聊文本唤醒前缀。示例: /agent 帮我总结这段话
# QQ_GROUP_MODE=mention 时它是 @ 之外的额外唤醒方式；QQ_GROUP_MODE=prefix 时它是唯一唤醒方式。
QQ_WAKE_PREFIX=/agent

# 群白名单，逗号分隔 QQ 群号。为空表示允许所有群。
# 示例: QQ_ALLOWED_GROUPS=123456789,987654321
QQ_ALLOWED_GROUPS=

# 用户白名单，逗号分隔 QQ 号。为空表示允许所有用户。
# 群聊和私聊都会检查该名单；如果填写，只有这些 QQ 用户能触发 agent。
# 示例: QQ_ALLOWED_USERS=10001,10002
QQ_ALLOWED_USERS=

# QQ root 用户，逗号分隔 QQ 号。这里不是“谁能聊天”，而是“谁能执行敏感工具”。
# 未配置时，QQ 等多人通讯平台触发的敏感工具默认拒绝；TUI/CLI 不受影响。
# 敏感范围包括：file_read、写项目/服务器文件、非只读 bash、读取/外发本地文件内容、
# git 回滚/提交/推送、bash_permission 授权变更、memory/rag 写操作、run_skill_script、
# 发送项目/服务器本地文件、敏感 MCP 工具等。
# 普通用户仍可问答、搜索、查看 git status、使用 glob/ls/grep 文件列表、发送 sticker_name 表情包。
# 普通用户也可以生成或下载“新产物”到系统临时目录（Linux 通常是 /tmp/cb-agent-outputs/），
# 再通过 qqtool 上传/发送；
# 但不能把项目文件、配置文件、服务器隐私文件复制到临时目录绕过检查。
# 示例: QQ_ROOT_USERS=10001
QQ_ROOT_USERS=

# 通用多人通讯平台 root 用户。QQ 会同时检查 QQ_ROOT_USERS；未来其它多人平台也可复用。
# 微信 OC 是当前账号里的私聊 bot，不检查管理员名单。
# 示例: IM_ROOT_USERS=10001
IM_ROOT_USERS=

# MCP 展开工具名前缀的权限分类。默认 fetch_/tavily_/amap-maps_ 视为普通查询；
# github_/playwright_ 视为敏感。自定义 MCP server 可在这里补前缀，逗号分隔。
CBAGENT_MCP_PUBLIC_PREFIXES=
CBAGENT_MCP_SENSITIVE_PREFIXES=

# OneBot action 调用超时时间，单位秒。发送消息、上传文件都走这个超时。
QQ_ACTION_TIMEOUT_SECONDS=30

# QQ 群聊被唤醒时，额外拉取最近多少条群消息注入本轮模型上下文。
# 默认 50 条，帮助模型理解“上面/刚才/这个”等指代；设为 0 可关闭。
# 这段只进入当前轮 prompt，不写入 history/state/transcript/compact。
QQ_GROUP_CONTEXT_MESSAGES=50

# 最近群消息背景的最大字符数，超过会优先保留最新消息。
QQ_GROUP_CONTEXT_MAX_CHARS=8000

# 通讯软件事件输出等级。
# - normal: 默认值；发送最终回答、ask_user_question 编号问题、todo 摘要、错误/取消、后台任务提示、文件资源，
#           以及每次工具开始时的短提示，例如“（调用工具:grep {...}）”或“（执行命令:ls）”。
# - full: 额外发送工具完成、round、token、MCP/Buddy 状态等调试摘要；真实群聊可能刷屏。
IM_EVENT_VERBOSITY=normal

# 群聊是否显示工具过程消息。1/true/on=显示；0/false/off=群聊静默工具开始/完成/计划调用提示。
# 该开关只影响 group 会话，不影响私聊；也不影响最终回答、编号确认、敏感工具拒绝提示、
# qqtool 实际上传/发送的文件、图片、表情包。
IM_GROUP_TOOL_MESSAGES=1

# 是否把思考模型返回的 reasoning_content 同步到 QQ/微信等通讯软件。
# 默认关闭，避免群聊刷屏或暴露模型不稳定的中间判断；设为 1/true/on 后启用。
IM_SHOW_REASONING=0
# 开启 IM_SHOW_REASONING 后，每累计多少字符发送一段“【思考】”消息。
IM_REASONING_CHUNK_CHARS=1200
# 开启 IM_SHOW_REASONING 后，每一轮最多展示多少 reasoning 字符；0 表示不限制。
IM_REASONING_MAX_CHARS=8000

# QQ 用户回复 ask_user_question 编号后，是否发送“已选择: xxx”的短确认。
# 1/true/on=发送确认；0/false/off=静默确认，只让工具继续执行。
IM_CONFIRM_QUESTION_ANSWER=1

# 表情包目录。QQ/微信模式下模型可用平台专用工具上传这里的图片作为 sticker/image。
# 旧 send_message_asset 入口保留给事件兼容，但默认不再注册给模型。
# 支持相对路径和绝对路径；相对路径按项目根目录解析。默认目录已创建为 assets/stickers。
CBAGENT_STICKER_DIR=./assets/stickers

# 允许 agent 发送本地文件到通讯软件的单文件大小上限，单位 MB。
# 该限制覆盖 image/audio/video/file/sticker 的出站资源；工具会记录文件大小和 hash，不保存二进制到 history。
CBAGENT_OUTBOUND_FILE_MAX_MB=50

# QQ/NapCat 出站文件交付方式。
# - auto: 默认模式，按 mapped_path -> base64 -> 可访问 http -> path 生成候选并依次尝试。
# - path: 兼容旧行为，直接把 cb-agent 本机路径传给 NapCat。适合同机运行或容器内外路径本来就一致的部署。
# - mapped_path: 先复制到 QQ_FILE_HOST_PREFIX，再把路径改写成 QQ_FILE_NAPCAT_PREFIX 下的容器路径。推荐 Docker 部署使用。
# - http: cb-agent 启动只读临时 HTTP 文件服务，NapCat 通过 URL 下载文件。适合容器/跨机器但网络必须互通。
# - base64: 小文件内联成 base64:// 发送，适合小图片/表情，不适合大文件。
QQ_FILE_DELIVERY_MODE=auto

# mapped_path 模式配置。
# QQ_FILE_HOST_PREFIX 是宿主机上 cb-agent 可写的共享目录；
# QQ_FILE_NAPCAT_PREFIX 是同一个目录在 NapCat Docker 容器内看到的路径。
# Docker 示例: -v /opt/cb-agent/outbound:/app/cb-agent-outbound:ro
# 对应配置:
#   QQ_FILE_HOST_PREFIX=/opt/cb-agent/outbound
#   QQ_FILE_NAPCAT_PREFIX=/app/cb-agent-outbound
QQ_FILE_HOST_PREFIX=
QQ_FILE_NAPCAT_PREFIX=
# mapped_path 共享目录清理：只删除交付层生成的 name-16hex.ext 文件。
# 设为 0 可分别关闭 TTL 或数量上限清理。
QQ_FILE_SHARED_TTL_SECONDS=86400
QQ_FILE_SHARED_MAX_FILES=1000

# http 模式配置。
# QQ_FILE_HTTP_HOST 是 cb-agent 本机监听地址；Docker/局域网访问通常用 0.0.0.0。
# QQ_FILE_HTTP_PORT=0 表示随机端口；如果 NapCat 需要固定 URL，建议填固定端口。
# QQ_FILE_HTTP_PUBLIC_BASE_URL 是 NapCat 容器实际能访问到的公开地址，Docker 本机常见写法:
#   http://host.docker.internal:6200
# Linux Docker 默认不一定支持 host.docker.internal，可改用宿主机内网 IP。
# URL 会带随机 token，且只暴露被发送的文件；过期后无法下载。
QQ_FILE_HTTP_HOST=127.0.0.1
QQ_FILE_HTTP_PORT=0
QQ_FILE_HTTP_PUBLIC_BASE_URL=
QQ_FILE_HTTP_TTL_SECONDS=300

# base64 模式或 auto 兜底中允许内联的单文件大小上限，单位 MB。
# 大文件不要用 base64，容易撑爆 WebSocket、日志和内存。
QQ_FILE_BASE64_MAX_MB=3

# QQ 收到图片/音频 URL 后的本地落盘目录。
# 下载成功后，后端只把本地路径交给现有多模态输入层；下载失败时只把 URL 作为文本提示交给模型。
# 相对路径按启动 run_agent.py 时的当前目录解析。
CBAGENT_PLATFORM_ATTACHMENT_DIR=.cbagent/platform_attachments/qq

# ========== WeChat / OC ==========
# 微信接入使用个人微信 OC HTTP 协议:
#   1. 启动 cb-agent: python run_agent.py --transport wechat
#   2. 第一次没有 token 时，终端会打印二维码；用手机微信扫码并确认授权。
#   3. 登录成功后 token/account_id/sync_buf 会写入 WECHAT_STATE_FILE，下次启动会自动恢复。
#   4. WECHAT_ENABLE=0 时即使命令使用 --transport wechat，也不会启动微信长轮询。
WECHAT_ENABLE=0

# 微信 OC API 地址。默认值参考 openclaw-weixin / AstrBot 的个人微信 OC 适配。
# 一般不需要修改；如果上游服务迁移或你有代理网关，再改这里。
WECHAT_BASE_URL=https://ilinkai.weixin.qq.com

# 微信媒体 CDN 地址。图片、视频、文件发送会先上传到这里，再通过 sendmessage 发出。
# 和 QQ/NapCat 不同，微信媒体发送不依赖 Docker 共享目录。
WECHAT_CDN_BASE_URL=https://novac2c.cdn.weixin.qq.com/c2c

# 可选。也可以留空让扫码登录后自动写入 WECHAT_STATE_FILE。
# 如果手动填写，注意 .env 不要提交；token 等同于微信登录凭据。
WECHAT_TOKEN=
WECHAT_ACCOUNT_ID=

# OC bot_type。默认 3；除非接口文档或上游项目要求，否则不要改。
WECHAT_BOT_TYPE=3

# 普通 API 超时和 getupdates 长轮询超时，单位毫秒。
# 长轮询超时不代表异常，adapter 会继续下一轮轮询。
WECHAT_API_TIMEOUT_MS=15000
WECHAT_LONG_POLL_TIMEOUT_MS=35000

# 扫码登录状态轮询间隔，单位秒。
WECHAT_QR_POLL_INTERVAL_SECONDS=1

# openclaw-weixin 的 OC bot 是当前微信账号里的 direct 私聊 bot，不是独立机器人账号。
# 因此微信模式不提供群聊唤醒、用户白名单或 root 用户分级配置：
# - 上游如果下发 group_id，cb-agent 会忽略这条消息，避免在微信群里误触发。
# - 微信模式按本机可信用户处理，不检查管理员名单。
# - 主动发送图片/文件走微信 CDN 上传，不需要 QQ/NapCat 那样的 Docker 共享目录。

# 微信登录态与轮询游标持久化文件。建议保留在 .cbagent 下，权限会尽量设为 600。
WECHAT_STATE_FILE=.cbagent/wechat/state.json

# 微信收到图片/文件/语音后落盘的目录。
# 图片会交给多模态输入层；SILK 语音当前只保存并提示路径，后续可接 SILK 转 WAV。
CBAGENT_PLATFORM_ATTACHMENT_DIR_WECHAT=.cbagent/platform_attachments/wechat

# wechattool 调用 adapter action 的超时时间，单位秒。
WECHAT_ACTION_TIMEOUT_SECONDS=30

# ========== Embedding（向量化模型） ==========
# RAG / 向量记忆使用
EMBED_MODEL_TYPE=remote          # remote | local
EMBED_MODEL_NAME=qwen3-embedding:0.6b
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=ollama

# ========== OCR（图片转文本） ==========
OCR_MODEL_TYPE=remote
OCR_MODEL_NAME=
OCR_BASE_URL=
OCR_API_KEY=

# ========== ASR（语音转文本） ==========
ASR_MODEL_TYPE=remote
ASR_MODEL_NAME=
ASR_BASE_URL=
ASR_API_KEY=

# ========== 向量存储 ==========
VECTOR_STORE_TYPE=zvec           # zvec(本地内置) | qdrant
ZVEC_DATA_PATH=./zvec_data

# Qdrant（VECTOR_STORE_TYPE=qdrant 时使用）
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=cb_agent
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE=Cosine
QDRANT_TIMEOUT=10

# ========== 图存储 ==========
GRAPH_STORE_TYPE=sqlite          # sqlite | neo4j
SQLITE_GRAPH_PATH=./graph_data/graph.db

# ========== 搜索工具 ==========
TAVILY_API_KEY=
SERPAPI_API_KEY=

# ========== MCP 服务器密钥 ==========
# mcp.json 通过 ${VAR} 占位符引用以下变量
AMAP_MAPS_API_KEY=
