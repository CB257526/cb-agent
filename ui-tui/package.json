{
  "name": "cb-agent-tui",
  "version": "0.1.0",
  "description": "Terminal UI for cb-agent (Stage 5b). Spawns the Python agent and renders its event stream as a Claude Code-style TUI.",
  "private": true,
  "type": "module",
  "bin": {
    "cb-tui": "./dist/entry.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/entry.tsx",
    "dev": "tsx watch src/entry.tsx",
    "test": "vitest run",
    "smoke": "tsx src/__smoke__/transport.smoke.ts"
  },
  "dependencies": {
    "ink": "5.0.1",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.7.4",
    "@types/react": "18.3.11",
    "tsx": "4.19.1",
    "typescript": "5.6.2",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
